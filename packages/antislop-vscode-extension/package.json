{
  "name": "@antislop/vscode-extension",
  "displayName": "AntiSlop Active-Cognition IDE",
  "description": "Active-cognition desktop IDE extension combating AI-induced developer skill atrophy",
  "version": "0.2.5",
  "publisher": "antislop",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Education"
  ],
  "main": "./dist/extension.js",
  "types": "./dist/index.d.ts",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "antislop.openDiagnosticScreen",
        "title": "AntiSlop: Open Diagnostic Screen (Screen B)"
      },
      {
        "command": "antislop.clearHighlights",
        "title": "AntiSlop: Clear Highlights"
      },
      {
        "command": "antislop.highlightLine",
        "title": "AntiSlop: Highlight Line"
      }
    ],
    "configuration": {
      "title": "AntiSlop IDE",
      "properties": {
        "antislop.sidecar.url": {
          "type": "string",
          "default": "ws://127.0.0.1:4949",
          "description": "Local WebSocket URL of the Antigravity Sidecar Daemon"
        },
        "antislop.sidecar.token": {
          "type": "string",
          "default": "",
          "description": "Bearer token for sidecar daemon authentication"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@antislop/protocol": "0.2.4",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.14",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
