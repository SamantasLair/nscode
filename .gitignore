# ==============================================================================
# NSCode Monorepo .gitignore (HARDENED PRODUCTION SPECIFICATION)
# Make Coders Great Again. No Slop.
# Architecture: TypeScript Monorepo | Vite | Electron Desktop | Eclipse Theia
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
packages/*/node_modules/
packages/**/node_modules/
.pnp/
.pnp.js
.pnp.cjs
.pnp.loader.mjs
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.yarn/sdks/
.yarn/versions/

# ------------------------------------------------------------------------------
# 2. TypeScript Monorepo & Build Artifacts
# ------------------------------------------------------------------------------
dist/
build/
out/
out-tsc/
