packages/**/dist/
packages/*/lib/
packages/**/lib/
*.tsbuildinfo
tsconfig.tsbuildinfo
tsconfig.*.tsbuildinfo
packages/*/*.tsbuildinfo
packages/**/tsconfig.tsbuildinfo
packages/**/tsconfig.*.tsbuildinfo

# ------------------------------------------------------------------------------
